{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-emr.org/clinical-copilot/contracts/chat.chart-changed.response.schema.json",
  "title": "chat.php chart-changed response",
  "description": "HTTP 200 body for action=ask when the client's facts_hash no longer matches the chart. Carries the fresh fact table and no answer; the panel restarts the thread on the new facts. Built by PanelPayload::chartChanged().",
  "type": "object",
  "properties": {
    "correlation_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "prior_visit": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "facts_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "facts": { "type": "array", "items": { "$ref": "fact.schema.json" } },
    "chart_changed": { "const": true }
  },
  "required": ["correlation_id", "prior_visit", "facts_hash", "facts", "chart_changed"],
  "additionalProperties": false
}
