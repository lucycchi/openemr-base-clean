{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-emr.org/clinical-copilot/contracts/run.request.schema.json",
  "title": "Sidecar run request",
  "description": "PHP -> sidecar POST /run. Three modes: extract (documents carry bytes; the graph runs the intake_extractor), answer (a question; the graph runs the evidence_retriever) and brief (the chart's fired guideline triggers as fixed queries, no question; the graph runs the evidence_retriever once for all of them, then the critic). The sidecar never receives patient identifiers: facts_hash is the Week 1 fact-set hash, question text is the physician's words (it may name drugs or labs, never the patient). correlation_id is the idempotency key for 10 minutes.",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "extract",
        "answer",
        "brief"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8
    },
    "facts_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "integer",
            "minimum": 1
          },
          "doc_type": {
            "type": "string",
            "enum": [
              "lab_pdf",
              "intake_form"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "stored",
              "extracted",
              "failed"
            ]
          },
          "sha3_512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "bytes_base64": {
            "type": [
              "string",
              "null"
            ],
            "description": "PDF bytes, base64; present only when status=stored (not yet extracted)."
          }
        },
        "required": [
          "document_id",
          "doc_type",
          "status",
          "sha3_512",
          "bytes_base64"
        ],
        "additionalProperties": false
      }
    },
    "queries": {
      "type": "array",
      "maxItems": 20,
      "description": "brief mode only: one entry per guideline trigger the chart fired (contracts/guideline_triggers.json); the query text is the rule's fixed query, whose vector the index build committed.",
      "items": {
        "type": "object",
        "properties": {
          "trigger_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z0-9_-]+$"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "facts": {
            "type": "array",
            "maxItems": 200,
            "description": "this trigger's own fact lines and the active problem list, flattened, for the critic; chart text is data, never instructions.",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "trigger_id",
          "query"
        ],
        "additionalProperties": false
      }
    },
    "patient": {
      "type": [
        "object",
        "null"
      ],
      "description": "brief mode only: age and sex at birth for the critic's population check; never an identifier.",
      "properties": {
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 130
        },
        "sex": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "M",
            "F",
            null
          ]
        }
      },
      "required": [
        "age",
        "sex"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "maxItems": 200,
      "description": "brief mode only: the flattened fact lines the fired triggers cited, for the critic. Chart text is data, never instructions.",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "required": [
    "mode",
    "correlation_id",
    "facts_hash",
    "question",
    "documents"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "mode": {
          "enum": [
            "extract",
            "answer"
          ]
        },
        "queries": {
          "maxItems": 0
        },
        "facts": {
          "maxItems": 0
        },
        "patient": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "mode": {
          "enum": [
            "brief"
          ]
        },
        "question": {
          "type": "null"
        }
      },
      "required": [
        "queries"
      ]
    }
  ]
}
