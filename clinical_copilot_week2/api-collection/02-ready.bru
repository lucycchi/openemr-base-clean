meta {
  name: 02 Ready
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/interface/modules/custom_modules/oe-module-clinical-copilot/public/ready.php
}

assert {
  res.status: eq 200
  res.body.dependencies.database: eq ok
  res.body.dependencies.openai: eq ok
}

docs {
  Probes the database, OpenAI and Langfuse (each bounded to 2 s). 503 if the
  database or OpenAI is down; 200 "degraded" if only Langfuse is. Cached 60 s.
  The sidecar has no probe here yet (tracked under engineering requirement 6);
  requests 8 and 11 are the proof it is up.
}
