meta {
  name: 13 Restricted user: login page (new session)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/interface/login/login.php?site=default
}

script:pre-request {
  bru.setVar("cookie", "");
}

script:post-response {
  // Capture OpenEMR cookies explicitly so the collection also works in the
  // Bruno CLI, which does not persist cookies between requests.
  const raw = (res.headers && res.headers["set-cookie"]) || res.getHeader("set-cookie");
  const list = Array.isArray(raw) ? raw : (raw ? [raw] : []);
  const pairs = list.map(c => String(c).split(";")[0]).filter(c => !/=deleted$/.test(c));
  const jar = {};
  String(bru.getVar("cookie") || "").split("; ").filter(Boolean).forEach(p => { jar[p.split("=")[0]] = p; });
  pairs.forEach(p => { jar[p.split("=")[0]] = p; });
  bru.setVar("cookie", Object.values(jar).join("; "));
}

assert {
  res.status: eq 200
}

docs {
  Drops the admin session and starts a fresh one for the restricted user.
}
