{
  "name": "patient-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "OpenEMR patient dashboard ported to React + TypeScript, served by a Node backend-for-frontend over the FHIR API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:server": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-certs/dev-cert.pem} node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "vite build",
    "start": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-certs/dev-cert.pem} node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:parity": "playwright test --project=parity",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/fhir": "^0.0.44",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
