DOMAIN=copilot.example.com
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASS=change-me
OE_PASS=change-me
# Private GitLab project, cloned over SSH with the deploy key in ./deploy-ssh (see README).
FLEX_REPOSITORY=ssh://git@labs.gauntletai.com:22022/lucychi/openemr.git
FLEX_REPOSITORY_BRANCH=audit
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # or LANGFUSE_BASE_URL
# Optional: USD per 1M tokens, overrides the built-in list price for OPENAI_MODEL (cost_usd in logs/traces)
#OPENAI_INPUT_USD_PER_M=0.15
#OPENAI_OUTPUT_USD_PER_M=0.60
# Alert webhook receiver (public/alerts.php). Either credential is enough; set at least one.
# Langfuse's webhook signing secret (shown once when the webhook is created, "lf-whs-..."): verifies x-langfuse-signature.
LANGFUSE_WEBHOOK_SECRET=
# Fallback shared token for senders that cannot sign (X-Alert-Token header only, never a query string). openssl rand -hex 32.
ALERT_WEBHOOK_SECRET=
