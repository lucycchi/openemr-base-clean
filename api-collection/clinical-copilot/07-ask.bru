meta {
  name: 07 Ask
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/interface/modules/custom_modules/oe-module-clinical-copilot/public/chat.php
  body: formUrlEncoded
}

headers {
  Cookie: {{cookie}}
}

body:form-urlencoded {
  csrf_token_form: {{csrf_token}}
  action: ask
  facts_hash: {{facts_hash}}
  question: Which lab result was out of range and what is its reference range?
  transcript: []
}

assert {
  res.status: eq 200
  res.body.chart_changed: eq false
  res.body.answer.type: isString
}

docs {
  Follow-up over the same fact set. answer.type is "cited" (sentences with
  fact_ids, verified) or "not_in_facts" (the facts cannot answer it).
  Try: "By exactly how much does it exceed the range?" to see a computed
  number get stripped (answer.stripped > 0, sentences empty).
}
