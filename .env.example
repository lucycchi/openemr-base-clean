OPENAI_API_KEY=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"


# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=


DIGITALOCEAN__DROPLET_NAME=do-openemr
DIGITALOCEAN_API_TOKEN=

#gitlab personal access token with read_api and read_repository scopes
GITLAB_USERNAME=
USERNAME=
GITLAB_PERSONAL_ACCESS_TOKEN= # Optional: USD per 1M tokens, overrides the built-in list price for OPENAI_MODEL (cost_usd in logs/traces)
#OPENAI_INPUT_USD_PER_M=0.15
#OPENAI_OUTPUT_USD_PER_M=0.60

#langfuse and local

# Alert webhook secret: Langfuse sends it as the X-Alert-Token header to public/alerts.php.
# Same value as ALERT_WEBHOOK_SECRET in ~/openemr/.env on the droplet (do-openemr).
ALERT_WEBHOOK_SECRET=<key>

# Langfuse webhook signing secret (from the Langfuse webhook config); verifies x-langfuse-signature on alerts.php.
LANGFUSE_WEBHOOK_SECRET=<key>



COHERE_API_KEY=<key>
