# Copy to .env at the repository root (git-ignored) and fill in what you need.
#
# Local dev stack: PHP loads this file directly (interface/globals.php, Dotenv)
# and the copilot-sidecar container reads it through env_file in
# docker/development-easy/docker-compose.yml.
# Droplet: ~/openemr/.env there is read by docker/vps/docker-compose.yml, and
# only the variables that compose file passes on reach the containers.

# ---- Model provider (required for anything beyond the fact table) -----------
# Briefing and follow-up narration (PHP); page extraction, the critic and the
# query embedding (sidecar).
OPENAI_API_KEY=
# Chat model for PHP and the sidecar. Part of the briefing cache key.
OPENAI_MODEL=gpt-4o-mini
# Optional: USD per 1M tokens, overrides the built-in list price used for
# cost_usd in logs, traces and audit rows.
#OPENAI_INPUT_USD_PER_M=0.15
#OPENAI_OUTPUT_USD_PER_M=0.60

# ---- Guideline retrieval (sidecar) ------------------------------------------
# Optional. Enables Cohere rerank-v3.5 on guideline retrieval; without it the
# results keep reciprocal-rank-fusion order (the trace's `reranked` says which).
COHERE_API_KEY=

# ---- Observability (PHP) ----------------------------------------------------
# Traces, generations and scores per request. /ready reports "degraded"
# without the two keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse region. LANGFUSE_BASE_URL is read as a fallback; the default is
# https://cloud.langfuse.com.
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ---- Alerts (PHP, public/alerts.php) ----------------------------------------
# Shared token Langfuse sends as the X-Alert-Token header.
ALERT_WEBHOOK_SECRET=
# Langfuse webhook signing secret; verifies x-langfuse-signature.
LANGFUSE_WEBHOOK_SECRET=

# ---- Co-Pilot wiring (defaults are right for both compose files) ------------
# Where PHP reaches the sidecar. Both compose files already set this.
#COPILOT_SIDECAR_URL=http://copilot-sidecar:8000
# Morning pre-warm sweep (bin/console copilot:prewarm). Off unless truthy.
# Not passed through on the droplet; leave it off there.
#COPILOT_PREWARM_ENABLED=0
# COPILOT_EVAL_ENDPOINTS=1 turns on the sidecar's test-only /eval/* endpoints.
# The dev compose file sets it for the eval harness. Never set it on a
# deployment.

# ---- OpenEMR core -----------------------------------------------------------
# prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# true/1 disables periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active.
OPENEMR__NO_BACKGROUND_TASKS=

# ---- Developer tooling only (nothing in this repository reads these) --------
# Used from the developer's own shell and CLI tools to reach the droplet and
# the GitLab API. Leave empty unless you deploy this fork yourself; deployment
# is docker/vps/deploy.sh, documented in docker/vps/README.md.
DIGITALOCEAN__DROPLET_NAME=do-openemr
DIGITALOCEAN_API_TOKEN=
# GitLab personal access token with read_api and read_repository scopes.
GITLAB_USERNAME=
USERNAME=
GITLAB_PERSONAL_ACCESS_TOKEN=
